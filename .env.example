# Copia este fichero a .env y rellena tu clave.
#   cp .env.example .env
#
# Groq — free tier, SIN tarjeta de crédito.
# Consigue tu clave en: https://console.groq.com/keys
GROQ_API_KEY=

# Modelo por defecto. Alternativas gratuitas del free tier:
#   llama-3.1-8b-instant      → el más rápido y con más cuota diaria
#   llama-3.3-70b-versatile   → más capaz, menos cuota
#   openai/gpt-oss-20b        → alternativa
LLM_VCR_MODEL=llama-3.1-8b-instant

# Modo de operación: record | replay | bypass | refresh
LLM_VCR_MODE=record
