# Copy this file to .env and fill in your key.
#   cp .env.example .env
#
# Groq — free tier, NO credit card required.
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# Default model. Free-tier alternatives:
#   llama-3.1-8b-instant      → fastest, highest daily quota
#   openai/gpt-oss-120b       → more capable, supports strict structured outputs
#   openai/gpt-oss-20b        → middle ground
#
# Note: llama-3.3-70b-versatile was decommissioned on 2026-08-16.
# Groq recommends openai/gpt-oss-120b as its replacement.
LLM_VCR_MODEL=llama-3.1-8b-instant

# Operating mode: record | replay | bypass | refresh
LLM_VCR_MODE=record
