# Copy this file to .env and fill in your key.
#   cp .env.example .env
#
# Groq — free tier, NO credit card required.
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# Default model. Free-tier options, checked against Groq's live catalogue
# in September 2026:
#   openai/gpt-oss-20b    → fastest, highest quota. Returns clean JSON.
#   openai/gpt-oss-120b   → more capable, twice the price and slower.
#   qwen/qwen3.8-27b      → works, but hits the rate limit sooner.
#
# Avoid qwen/qwen3.6-27b: it emits its <think> reasoning inside the message
# content, which breaks any prompt asking for JSON only.
#
# Groq decommissioned llama-3.1-8b-instant and llama-3.3-70b-versatile on
# 2026-08-16. Both return 404 model_not_found.
LLM_VCR_MODEL=openai/gpt-oss-20b

# Operating mode: record | replay | bypass | refresh
LLM_VCR_MODE=record
