# Qué NO se descarga cuando alguien hace `composer require`.
#
# Sin esto, cada instalación del paquete arrastra tests, ejemplos y
# configuración de CI: peso muerto en el vendor/ de otros proyectos.
/.github            export-ignore
/tests              export-ignore
/examples           export-ignore
/docker             export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.env.example       export-ignore
/Dockerfile         export-ignore
/docker-compose.yml export-ignore
/Makefile           export-ignore
/phpunit.xml.dist   export-ignore
/phpstan.neon.dist  export-ignore
/EMPEZAR-AQUI.md    export-ignore

# Normalización de finales de línea.
* text=auto eol=lf
*.php   text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# PowerShell es nativo de Windows: CRLF.
/bin/verificar.ps1 text eol=crlf
/GUIA-PASO-A-PASO.md export-ignore
/.dockerignore      export-ignore
/bin/verificar.sh   export-ignore
/bin/verificar.ps1  export-ignore
