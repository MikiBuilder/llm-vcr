{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{#
    Panel de llm-vcr para el Web Profiler.

    La barra muestra de un vistazo si la petición tocó la red;
    el panel desglosa el ahorro en tiempo y tokens.
#}

{% block toolbar %}
    {% if collector.total > 0 or collector.cassetteCount > 0 %}
        {% set icon %}
            {# Icono de casete, en línea: los collectors oficiales llevan SVG
               y sin él nuestro bloque desentona en la barra. #}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5" width="20" height="14" rx="2"/>
                <circle cx="8.5" cy="12" r="2.2"/>
                <circle cx="15.5" cy="12" r="2.2"/>
                <path d="M8.5 16.5h7"/>
            </svg>
            <span class="sf-toolbar-value">{{ collector.replayed }}</span>
            <span class="sf-toolbar-label">cassette</span>
            {% if collector.live > 0 %}
                <span class="sf-toolbar-value">/ {{ collector.live }}</span>
                <span class="sf-toolbar-label">API</span>
            {% endif %}
        {% endset %}

        {% set text %}
            <div class="sf-toolbar-info-piece">
                <b>Mode</b>
                <span class="sf-toolbar-status sf-toolbar-status-{{ collector.statusColor }}">{{ collector.mode }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>From cassette</b>
                <span>{{ collector.replayed }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Live calls</b>
                <span>{{ collector.live }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Tokens saved</b>
                <span>{{ collector.tokensSaved|number_format(0, '.', ',') }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Time saved</b>
                <span>{{ collector.latencySavedMs|number_format(0, '.', ',') }} ms</span>
            </div>
        {% endset %}

        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', {
            link: true,
            status: collector.statusColor
        }) }}
    {% endif %}
{% endblock %}

{% block menu %}
    <span class="label {{ collector.live > 0 and collector.mode == 'replay' ? 'label-status-error' : '' }}">
        <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="6" width="20" height="12" rx="2"/>
                <circle cx="8" cy="12" r="2"/>
                <circle cx="16" cy="12" r="2"/>
            </svg>
        </span>
        <strong>llm-vcr</strong>
        {% if collector.total > 0 %}
            <span class="count"><span>{{ collector.total }}</span></span>
        {% endif %}
    </span>
{% endblock %}

{% block panel %}
    <h2>llm-vcr</h2>

    <div class="metrics">
        <div class="metric">
            <span class="value">{{ collector.mode }}</span>
            <span class="label">Mode</span>
        </div>
        <div class="metric">
            <span class="value">{{ collector.replayed }}</span>
            <span class="label">From cassette</span>
        </div>
        <div class="metric">
            <span class="value">{{ collector.live }}</span>
            <span class="label">Live calls</span>
        </div>
        <div class="metric">
            <span class="value">{{ collector.hitRatePercent }}<span class="unit">%</span></span>
            <span class="label">Hit rate</span>
        </div>
    </div>

    <div class="metrics">
        <div class="metric">
            <span class="value">{{ collector.tokensSaved|number_format(0, '.', ',') }}</span>
            <span class="label">Tokens saved</span>
        </div>
        <div class="metric">
            <span class="value">{{ collector.latencySavedMs|number_format(0, '.', ',') }}<span class="unit">ms</span></span>
            <span class="label">Latency avoided</span>
        </div>
        <div class="metric">
            <span class="value">{{ collector.cassetteCount }}</span>
            <span class="label">Cassettes on disk</span>
        </div>
    </div>

    {% if collector.live > 0 and collector.mode == 'replay' %}
        <div class="card-block error">
            <p>
                <strong>{{ collector.live }} live calls were made in <code>replay</code> mode.</strong>
                That should not happen: check whether a cassette is missing.
            </p>
        </div>
    {% endif %}

    {#
        Sin esta nota, un "0 ms" con reproducciones parece un fallo del panel.
        En realidad la latencia se lee de la cassette: si se grabó contra una
        plataforma sin latencia, no hay tiempo que ahorrar que mostrar.
    #}
    {% if collector.replayed > 0 and collector.latencySavedMs == 0 %}
        <div class="card-block">
            <p>
                <strong>Latency avoided: 0 ms.</strong>
                The time saved is read from the cassette, and the one being
                replayed was recorded without latency (a simulated platform, or
                an earlier recording). With a real provider you will see how long
                each response took. To recalculate it, delete the cassette and
                record it again.
            </p>
        </div>
    {% endif %}

    {% if collector.total == 0 %}
        <div class="empty">
            <p>This request did not invoke any model.</p>
        </div>
    {% else %}
        <h3>Summary</h3>

        <table>
            <thead>
                <tr>
                    <th scope="col">Item</th>
                    <th scope="col">Value</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">Total invocations</th>
                    <td>{{ collector.total }}</td>
                </tr>
                <tr>
                    <th scope="row">Served from cassette</th>
                    <td>{{ collector.replayed }}</td>
                </tr>
                <tr>
                    <th scope="row">Sent to the provider</th>
                    <td>{{ collector.live }}</td>
                </tr>
                <tr>
                    <th scope="row">Wrapped platforms</th>
                    <td>{{ collector.platforms }}</td>
                </tr>
                <tr>
                    <th scope="row">Cassette directory</th>
                    <td><code>{{ collector.cassetteDir }}</code></td>
                </tr>
            </tbody>
        </table>
    {% endif %}

    <h3>Modes</h3>

    <table>
        <thead>
            <tr>
                <th scope="col">Mode</th>
                <th scope="col">When</th>
                <th scope="col">Behaviour</th>
            </tr>
        </thead>
        <tbody>
            <tr{% if collector.mode == 'record' %} class="status-success"{% endif %}>
                <th scope="row"><code>record</code></th>
                <td>Local development</td>
                <td>Records if missing; replays if present</td>
            </tr>
            <tr{% if collector.mode == 'replay' %} class="status-success"{% endif %}>
                <th scope="row"><code>replay</code></th>
                <td>CI</td>
                <td>Replay only; fails if the cassette is missing</td>
            </tr>
            <tr{% if collector.mode == 'bypass' %} class="status-success"{% endif %}>
                <th scope="row"><code>bypass</code></th>
                <td>Debugging</td>
                <td>Ignores cassettes, always hits the real API</td>
            </tr>
            <tr{% if collector.mode == 'refresh' %} class="status-success"{% endif %}>
                <th scope="row"><code>refresh</code></th>
                <td>Updating fixtures</td>
                <td>Re-records everything from scratch</td>
            </tr>
        </tbody>
    </table>
{% endblock %}
